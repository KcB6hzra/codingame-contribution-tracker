      "solution": "n = int(input())\neven = 0\nodd = 0\n\nfor i in input().split():\n    x = int(i)\n    if x % 2 == 0:\n        even += 1\n    else:\n        odd += 1\n\nprint(\"Even:\", even)\nprint(\"Odd:\", odd)",
