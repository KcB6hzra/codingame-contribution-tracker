      "title": "check passw@rd",
      "topics": [],
      "fastest": true,
      "reverse": false,
      "shortest": false,
      "solution": "const password: string = readline();\n\nlet score = 0;\n\nif (password.length >= 12) score++;\nif (/[a-z]/.test(password)) score++;\nif (/[A-Z]/.test(password)) score++;\nif (/[0-9]/.test(password)) score++;\nif (/[^a-zA-Z0-9]/.test(password)) score++;\n\nconst lowerPassword = password.toLowerCase();\nconst forbiddenWords = [\"password\", \"admin\", \"azerty\", \"qwerty\", \"1234\"];\n\nlet containsForbiddenWord = false;\n\nfor (const word of forbiddenWords) {\n    if (lowerPassword.includes(word)) {\n        containsForbiddenWord = true;\n        break;\n    }\n}\n\nif (!containsForbiddenWord) score++;\n\nif (score <= 3) {\n    console.log(\"WEAK\");\n} else if (score <= 5) {\n    console.log(\"MEDIUM\");\n} else {\n    console.log(\"STRONG\");\n}",
      "statement": "Determine the strength of a password.\n\nA password gains 1 point for each rule it satisfies:\n\n• Length is at least {{12}} characters.\n• Contains at least one lowercase letter.\n• Contains at least one uppercase letter.\n• Contains at least one digit.\n• Contains at least one non-alphanumerical character.\n• Does not contain any of these common passwords (case-insensitive): {{password}}, {{admin}}, {{azerty}}, {{qwerty}}, {{1234}}.\n\nThe result is:\n\n• {{WEAK}} if the score is between 0 and 3.\n• {{MEDIUM}} if the score is 4 or 5.\n• {{STRONG}} if the score is 6.",
