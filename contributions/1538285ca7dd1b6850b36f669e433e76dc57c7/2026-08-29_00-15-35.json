      "title": "Repair The Path",
      "topics": [],
      "fastest": false,
      "reverse": true,
      "shortest": false,
      "solution": "h=int(input());wi=int(input())\ngrid = [[i if i!=' ' else '' for i in input()] for j in range(h)]\n\nfor row in range(h):\n    for col, cell in enumerate(grid[row]):\n        if cell:\n            w = grid[row][col-1]\n            n = grid[row-1][col]\n            s = grid[row+1][col]\n            e = grid[row][col+1]\n            if [w,n,s,e].count('')==3:\n                grid[row][col] = '-' if w or e else '|'\n            elif w and e: grid[row][col]='-'\n            elif n and s: grid[row][col]='|'\n            elif (w and s) or (e and n): grid[row][col]='\\\\'\n            else: grid[row][col]='/'\nfor row in grid: print(''.join(i if i else ' ' for i in row))",
