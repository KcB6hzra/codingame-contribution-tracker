      "solution": "r,c=map(int,input().split())\ng=[list(map(int,input().strip())) for _ in range(r)]\nfor i in range(r):\n    out=[]\n    for j in range(c):\n        cnt=0\n        for di,dj in ((1,0),(-1,0),(0,1),(0,-1)):\n            ni,nj=i+di,j+dj\n            if 0<=ni<r and 0<=nj<c and g[ni][nj]%2!=g[i][j]%2:\n                cnt+=1\n        out.append(str(cnt))\n    print(' '.join(out))",
