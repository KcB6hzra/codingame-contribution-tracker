      "solution": "import sys\n\nn = int(input())\nnumbers = [int(x) for x in input().split()]\n\neven_sum = 0\nodd_sum = 0\n\nfor num in numbers:\n    if num % 2 == 0:\n        even_sum += num\n    else:\n        odd_sum += num\n\nprint(even_sum * odd_sum)",
