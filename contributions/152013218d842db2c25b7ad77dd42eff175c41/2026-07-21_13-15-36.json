      "solution": "n = int(input())\nh = list(map(int, input().split()))\n\npeaks = []\n\nfor i in range(1, n - 1):\n    if h[i] > h[i - 1] and h[i] > h[i + 1]:\n        peaks.append(str(h[i]))\n\nif peaks:\n    print(\" \".join(peaks))\nelse:\n    print(\"NONE\")",
