    "statementHTML": "<div class=\"statement-body\">\n<div class=\"statement-section statement-goal\">\n   <h2><span class=\"icon icon-goal\">&nbsp;</span><span>Goal </span></h2>\n   <span class=\"question-statement\">You are given a point (<var>x</var>, <var>y</var>) in the Cartesian plane and an angle <var>a</var>.<br>Rotate the point around the origin (0, 0) by <var>a</var> degrees <strong>counterclockwise</strong>.</span>\n</div>\n<div class=\"statement-section statement-protocol\">\n   <div class=\"blk\">\n      <div class=\"title\">Input</div>\n      <div class=\"question-statement-input\">A single line containing three space-separated integers: <var>x</var>, <var>y</var>, <var>a</var><br><var>x</var>: the x-coordinate of the point.<br><var>y</var>: the y-coordinate of the point.<br><var>a</var>: the rotation angle in degrees.</div>\n   </div>\n   <div class=\"blk\">\n      <div class=\"title\">Output</div>\n      <div class=\"question-statement-output\">Print two integers separated by a space: <var>x'</var> <var>y'</var><br><br>where (<var>x'</var>, <var>y'</var>) are the coordinates of the point after the rotation.</div>\n   </div>\n   <div class=\"blk\">\n      <div class=\"title\">Constraints</div>\n      <div class=\"question-statement-constraints\">-100 &lt; <var>x</var> &lt; 100<br>-100 &lt; <var>y</var> &lt; 100<br>0 &lt; <var>a</var> &le; 360<br><var>a</var> is a multiple of 90.</div>\n   </div>\n   <div class=\"blk\">\n      <div class=\"title\">Example</div>\n      <div class=\"statement-inout\">\n         <div class=\"statement-inout-in\">\n            <div class=\"title\">Input</div>\n            <pre class=\"question-statement-example-in\">3 2 90</pre>\n         </div>\n         <div class=\"statement-inout-out\">\n            <div class=\"title\">Output</div>\n            <pre class=\"question-statement-example-out\">-2 3</pre>\n         </div>\n      </div>\n   </div>\n</div>"
