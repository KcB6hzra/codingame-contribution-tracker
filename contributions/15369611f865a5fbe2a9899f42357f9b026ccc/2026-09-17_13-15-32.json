      "topics": [],
      "fastest": true,
      "reverse": false,
      "shortest": true,
      "solution": "#include <stdio.h>\n\nint main(void)\n{\n    int x, y, a;\n\n    scanf(\"%d %d %d\", &x, &y, &a);\n\n    switch ((a / 90) % 4)\n    {\n        case 0:\n            printf(\"%d %d\\n\", x, y);\n            break;\n\n        case 1:\n            printf(\"%d %d\\n\", -y, x);\n            break;\n\n        case 2:\n            printf(\"%d %d\\n\", -x, -y);\n            break;\n\n        case 3:\n            printf(\"%d %d\\n\", y, -x);\n            break;\n    }\n\n    return 0;\n}",
