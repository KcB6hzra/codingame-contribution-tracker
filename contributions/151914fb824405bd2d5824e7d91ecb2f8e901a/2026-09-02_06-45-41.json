      "solution": "#include <iostream>\n#include <string>\n#include <vector>\n#include <algorithm>\nusing namespace std;\nint main()\n{\n    int a;\n    int b;\n    cin>>a>>b; cin.ignore();\n    string s;\n    getline(cin, s);\n    int sum;\n    if(s==\"+\"){\n        sum=a+b;\n        cout<< sum <<endl;\n    }\n    else if(s==\"-\"){\n        sum=a-b;\n        cout<< sum <<endl;\n    }\n    else if(s==\"*\"){\n        sum=a*b;\n        cout<< sum <<endl;\n    }\n    else if(s==\"/\"){\n        sum=a/b;\n        cout<< sum <<endl;\n    }\n    else{\n        sum=a%b;\n        cout<< sum <<endl;\n    }\n}",
