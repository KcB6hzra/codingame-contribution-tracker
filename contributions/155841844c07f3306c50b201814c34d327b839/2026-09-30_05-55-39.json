      "solution": "const assert = require(\"assert\");\nconst n = parseInt(readline());\n\nconst lines = [];\nwhile (l=readline())lines.push(l);\n\nassert.ok( lines.length == n );\nassert.ok( lines.every(line => line.length == 23 ) );\n\nfor (let i = 0; i < n; i++) {\n  const line = lines[i];\n  const j = line.indexOf(\"j\");\n  if (j != -1) {\n    const tailIndex = line.slice(0, j).lastIndexOf(\">\");\n    console.log(line.slice(tailIndex, tailIndex + 3));\n    break;\n  }\n}",
