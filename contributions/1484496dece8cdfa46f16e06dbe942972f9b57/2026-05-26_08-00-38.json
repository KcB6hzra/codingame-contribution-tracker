      "solution": "import java.util.Scanner;\n\npublic class Solution {\n    public static void main(String[] args) {\n        Scanner in = new Scanner(System.in);\n        int n = in.nextInt();\n        \n        int reversed = 0;\n        int original = n;\n        \n        while (n > 0) {\n            reversed = reversed * 10 + n % 10;\n            n = n / 10;\n        }\n        \n        System.out.println(original + reversed);\n    }\n}",
