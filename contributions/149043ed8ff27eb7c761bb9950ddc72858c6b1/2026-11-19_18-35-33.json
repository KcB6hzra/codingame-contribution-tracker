      "solution": "a=input().strip()\nb=input().strip()\ncarry=0\nout=[]\nfor i in range(len(a)-1,-1,-1):\n    s=int(a[i])+int(b[i])+carry\n    carry=1 if s>=2 else 0\n    out.append(str(carry))\nprint(''.join(reversed(out)))",
