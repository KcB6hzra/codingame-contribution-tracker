      "solution": "string = gets.chomp\nputs (string.size/2.0).ceil.times.map{ | i |\n  row = [\" \"] * string.size\n  row[i] = string[i]\n  row[string.size - 1 - i] = string[-1 - i]\n  row.join.rstrip\n}.reverse",
