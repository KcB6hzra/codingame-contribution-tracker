      "solution": "r = int(input())\nn = int(input())\npaths = []\nfor i in range(n):\n    paths += [list(map(int,input().split()))]\n\nrooms = [0]*r\n\nfor path in paths:\n    for room in path:\n        rooms[room-1]+=1\n\nprint(*rooms)",
