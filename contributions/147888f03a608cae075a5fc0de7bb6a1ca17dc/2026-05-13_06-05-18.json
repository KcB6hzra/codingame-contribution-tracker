      "solution": "n = int(input())\nnums = []\nfor i in range(n):\n    nums.append(int(input()))\ntarget = int(input())\n\nseen = {}\nfor i, num in enumerate(nums):\n    complement = target - num\n    if complement in seen:\n        print(seen[complement], i)\n        break\n    seen[num] = i",
