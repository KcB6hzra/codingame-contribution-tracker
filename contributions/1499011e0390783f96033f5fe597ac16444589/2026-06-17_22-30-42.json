      "solution": "const r = parseInt(readline());\nfor (let i = 0; i < r; i++) {\n    const tokens = readline().trim().split(' ');\n    let line = '';\n    for (const t of tokens) {\n        const val = parseInt(t[0]);\n        const count = parseInt(t[1]);\n        const ch = val === 0 ? '.' : val === 3 ? '+' : val === 5 ? '#' : '*';\n        line += ch.repeat(count);\n    }\n    console.log(line);\n}",
