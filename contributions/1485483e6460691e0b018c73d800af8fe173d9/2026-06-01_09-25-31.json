      "title": "The Mirror Number",
      "topics": [],
      "fastest": true,
      "reverse": false,
      "shortest": true,
      "solution": "using System;\n\nclass Solution\n{\n    static void Main()\n    {\n        long N = long.Parse(Console.ReadLine());\n\n        string sN = N.ToString();\n        char[] chars = sN.ToCharArray();\n        Array.Reverse(chars);\n\n        long reversed = long.Parse(new string(chars));\n\n        if (reversed == N)\n        {\n            Console.WriteLine($\"No, {N} is a Palindrome\");\n            return;\n        }\n\n        long M = N + reversed;\n\n        string sM = M.ToString();\n\n        bool isPalindrome = true;\n        int left = 0;\n        int right = sM.Length - 1;\n\n        while (left < right)\n        {\n            if (sM[left] != sM[right])\n            {\n                isPalindrome = false;\n                break;\n            }\n\n            left++;\n            right--;\n        }\n\n        if (isPalindrome)\n            Console.WriteLine($\"Yes, {N} is a Mirror Number\");\n        else\n            Console.WriteLine($\"No, {M} is not a Palindrome\");\n    }\n}",
      "statement": "A number is called a Mirror Number if:\n\n- Reversing its digits produces a number different from the original.\n- The sum of the original number and its reversed number is a palindrome.\n\nDetermine whether [[N]] is a Mirror Number.",
